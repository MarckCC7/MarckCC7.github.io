# Copia este archivo a `.env` y ajusta los valores.
# Todas las variables expuestas al navegador deben empezar por VITE_.

# Origen canónico del sitio, sin barra final.
# Se usa en canonical, Open Graph, JSON-LD, robots.txt y el sitemap.
#
# En producción NO se lee de aquí: lo fija el workflow de GitHub Actions desde
# la variable de repositorio SITE_URL. Este archivo es solo para local.
VITE_SITE_URL=https://marckcc7.github.io
