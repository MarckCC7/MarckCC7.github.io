    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.7.0",
    "sharp": "^0.35.0",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
