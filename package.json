    "clsx": "2.1.1",
    "framer-motion": "12.43.0",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "lucide-react": "1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "tailwind-merge": "3.6.0"
